# Copiar a .env.local. Son variables públicas: Next.js las incluye en el
# código que descarga el navegador, así que acá nunca va un secreto.

NEXT_PUBLIC_API_URL=http://localhost:3001

# Site key de Cloudflare Turnstile. En local, la clave de prueba de Cloudflare
# que siempre aprueba (el backend corre con CAPTCHA_DISABLED=true).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
