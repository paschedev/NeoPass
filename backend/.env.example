# Copiar a .env y completar. Nunca commitear el .env.
# La app valida estas variables al arrancar (src/config/env.validation.ts):
# si falta una o es inválida, no arranca y el error lista solo los nombres.

# Postgres del servicio db de docker-compose.yml. DIRECT_URL la usa solo
# Prisma CLI para migrar; en local es igual a DATABASE_URL.
DATABASE_URL=postgresql://user:password@localhost:5432/neopass
DIRECT_URL=postgresql://user:password@localhost:5432/neopass

# Redis del servicio redis de docker-compose.yml.
REDIS_URL=redis://localhost:6379

# Secreto para firmar las sesiones: largo y aleatorio.
JWT_SECRET=

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001

# Credenciales de tu aplicación de Mercado Pago (Tus integraciones).
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
# Clave secreta de Webhooks. En local sirve cualquier valor.
MERCADOPAGO_WEBHOOK_SECRET=
# Cifra los tokens de Mercado Pago de los organizadores: 32 bytes en base64.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MERCADOPAGO_TOKEN_KEY=

RESEND_API_KEY=
# cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# En local el captcha se desactiva. En producción, CAPTCHA_DISABLED hace
# fallar el arranque y TURNSTILE_SECRET_KEY es obligatoria.
CAPTCHA_DISABLED=true
TURNSTILE_SECRET_KEY=
