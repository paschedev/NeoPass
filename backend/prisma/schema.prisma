generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  ORGANIZER
  CUSTOMER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  PAUSED
  FINISHED
  CANCELLED
}

enum NotificationType {
  SYSTEM
  STAFF_INVITE
  TICKET_PURCHASE
  EVENT_UPDATE
  PROMOTER_SALE
  EVENT_SALES
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
}

enum TicketStatus {
  VALID
  USED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  MERCADO_PAGO
}

enum StaffRole {
  SCANNER
  PROMOTER
  MANAGER
}

// What a co-organizer (MANAGER) can do on the event besides scanning.
enum EventPermission {
  EDIT_EVENT
  MANAGE_BATCHES
  VIEW_SALES
  SEND_FREE_TICKETS
  VIEW_ATTENDEES
  MANAGE_STAFF
}

enum EventActivityType {
  CO_ORGANIZER_INVITED
  CO_ORGANIZER_UPDATED
  CO_ORGANIZER_REMOVED
  STAFF_INVITED
  EVENT_UPDATED
  BATCHES_UPDATED
  BATCH_SALE_CHANGED
  FREE_TICKETS_SENT
  FREE_TICKETS_CANCELLED
  FREE_TICKETS_RESENT
  PROMOTER_PAYMENT_REGISTERED
  ATTENDEES_EXPORTED
}

enum StaffStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

enum TicketCategory {
  GENERAL
  VIP
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  // Which mailbox the email reaches: lowercase and, for Gmail, without dots or
  // "+…" (googlemail.com is gmail.com). The database fills it in on every
  // write (trigger "User_normalize_email", which also stores the email in
  // lowercase) and accounts are looked up with its function email_key().
  emailKey     String   @unique @default("")
  passwordHash String
  name         String
  role         UserRole @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  // Mercado Pago (OAuth). The access token lasts 180 days and is renewed with
  // the refresh token, which changes on every renewal. Accounts linked before
  // the renewal existed have neither.
  mercadoPagoAccessToken    String?
  mercadoPagoPublicKey      String?
  mercadoPagoUserId         String?
  mercadoPagoRefreshToken   String?
  mercadoPagoTokenExpiresAt DateTime?

  // Password Reset (the token is stored as a SHA-256 hash)
  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?
  // Sessions issued before this moment are no longer valid
  passwordChangedAt    DateTime?

  // Relations
  orders                     Order[]
  tickets                    Ticket[] // Tickets currently owned by the user
  checkIns                   CheckIn[] // Scans performed by this user
  organizedEvents            Event[]           @relation("EventOrganizer")
  deletedEvents              Event[]           @relation("EventDeletedBy")
  organizerProfile           OrganizerProfile?
  eventStaff                 EventStaff[]
  promoterPaymentsRegistered PromoterPayment[]
  eventActivity              EventActivity[]
  freeTicketGrantsIssued     FreeTicketGrant[]
  ticketPresets              TicketPreset[]    @relation("OrganizerPresets")
  notifications              Notification[]
}

model OrganizerProfile {
  id          String  @id @default(uuid())
  phone       String
  companyName String?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])
}

model Event {
  id          String      @id @default(uuid())
  title       String
  description String
  startDate   DateTime
  endDate     DateTime
  status      EventStatus @default(DRAFT)
  createdAt   DateTime    @default(now())

  venueName     String?
  venueAddress  String?
  venueCity     String?
  venueCapacity Int?
  latitude      Float?
  longitude     Float?
  venuePlaceId  String?

  imageUrl    String?
  youtubeLink String?

  // NeoPass's service fee, charged to the buyer on top of the ticket price.
  // Only ADMIN changes it; the database keeps it between 0 and 100.
  neoPassFeePercentage Decimal @default(15.0) @db.Decimal(5, 2)
  // Unused: the fee's old column (WePass name). Ignored by the client so the
  // version that drops it can deploy while this one is still serving.
  legacyFeePercentage  Decimal @default(15.0) @map("wePassFeePercentage") @db.Decimal(5, 2) @ignore

  organizerId   String
  organizer     User              @relation("EventOrganizer", fields: [organizerId], references: [id])

  // A deleted event leaves the public site but stays for its organizer, its
  // staff and whoever bought tickets. Deleted by its organizer or, to take it
  // down, by a NeoPass admin; buyers get in touch through the contact email.
  deletedAt            DateTime?
  deletedById          String?
  deletedBy            User?     @relation("EventDeletedBy", fields: [deletedById], references: [id])
  deletionContactEmail String?

  ticketBatches TicketBatch[]
  ticketTypes   TicketType[]
  discountCodes DiscountCode[]
  staff         EventStaff[]
  notifications Notification[]
  freeTickets   FreeTicketGrant[]
  activity      EventActivity[]

  @@index([organizerId])
}

model TicketBatch {
  id                         String       @id @default(uuid())
  eventId                    String
  event                      Event        @relation(fields: [eventId], references: [id])
  name                       String // ej: "Preventa", "Lote 1"
  // Only visibility is stored: whether the batch is on sale, upcoming, sold out
  // or ended comes from these dates and the stock (src/events/batch-sale-status.ts).
  isVisible                  Boolean      @default(false)
  publishAt                  DateTime? // Sale starts (null: right away)
  closeAt                    DateTime? // Sale ends (null: when the event ends)
  publishWhenPreviousSoldOut Boolean      @default(false)
  showTimer                  Boolean      @default(false)
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt
  ticketTypes                TicketType[]

  @@index([eventId])
}

model TicketType {
  id          String         @id @default(uuid())
  eventId     String
  event       Event          @relation(fields: [eventId], references: [id])
  batchId     String?
  batch       TicketBatch?   @relation(fields: [batchId], references: [id])
  category    TicketCategory @default(GENERAL)
  name        String
  description String?
  price       Decimal        @db.Decimal(10, 2)
  stock       Int
  sold        Int            @default(0)
  reserved    Int            @default(0)

  tickets     Ticket[]
  orderItems  OrderItem[]
  freeTickets FreeTicketGrant[]

  @@index([eventId])
  @@index([batchId])
}

model TicketPreset {
  id          String  @id @default(uuid())
  organizerId String
  name        String
  price       Decimal @db.Decimal(10, 2)

  organizer User @relation("OrganizerPresets", fields: [organizerId], references: [id])

  @@index([organizerId])
}

model DiscountCode {
  id         String   @id @default(uuid())
  code       String   @unique
  percentage Int
  maxUses    Int
  usedCount  Int      @default(0)
  expiresAt  DateTime

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  @@index([eventId])
}

model Order {
  id           String      @id @default(uuid())
  status       OrderStatus @default(PENDING)
  totalAmount  Decimal     @db.Decimal(10, 2)
  serviceFee   Decimal     @default(0) @db.Decimal(10, 2)
  ticketAmount Decimal     @default(0) @db.Decimal(10, 2)
  createdAt    DateTime    @default(now())
  expiresAt    DateTime

  userId String
  user   User   @relation(fields: [userId], references: [id])

  promoterId         String?
  promoter           EventStaff? @relation("OrderPromoter", fields: [promoterId], references: [id])
  // What the promoter earned with this order, fixed when it was paid so that a
  // later change to the commission does not rewrite past sales.
  promoterCommission Decimal?    @db.Decimal(10, 2)

  payment    Payment?
  orderItems OrderItem[]
  tickets    Ticket[]

  @@index([userId])
  @@index([promoterId])
}

model OrderItem {
  id        String  @id @default(uuid())
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)

  orderId      String
  order        Order      @relation(fields: [orderId], references: [id])
  ticketTypeId String
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])

  @@index([orderId])
  @@index([ticketTypeId])
}

model Payment {
  id                String          @id @default(uuid())
  provider          PaymentProvider @default(MERCADO_PAGO)
  providerPaymentId String?
  status            PaymentStatus   @default(PENDING)
  amount            Decimal         @db.Decimal(10, 2)
  createdAt         DateTime        @default(now())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model Ticket {
  id          String       @id @default(uuid())
  qrCode      String       @unique @default(uuid())
  status      TicketStatus @default(VALID)
  isGuestList Boolean      @default(false)
  createdAt   DateTime     @default(now())
  usedAt      DateTime?

  orderId      String?
  order        Order?     @relation(fields: [orderId], references: [id])
  ticketTypeId String
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])
  checkIn      CheckIn?

  userId String? // Current owner of the ticket (for transfers)
  user   User?   @relation(fields: [userId], references: [id])

  // Free tickets ("QR free") come from a grant instead of an order.
  freeTicketGrantId String?
  freeTicketGrant   FreeTicketGrant? @relation(fields: [freeTicketGrantId], references: [id])

  @@index([orderId])
  @@index([ticketTypeId])
  @@index([userId])
  @@index([freeTicketGrantId])
}

model CheckIn {
  id         String   @id @default(uuid())
  checkedAt  DateTime @default(now())
  deviceInfo String?

  ticketId  String @unique
  ticket    Ticket @relation(fields: [ticketId], references: [id])
  scannerId String
  scanner   User   @relation(fields: [scannerId], references: [id])

  @@index([ticketId])
  @@index([scannerId])
}

model EventStaff {
  id      String      @id @default(uuid())
  eventId String
  userId  String
  role    StaffRole
  status  StaffStatus @default(PENDING)

  // Especifico para Promotores (RPP)
  commissionType  CommissionType?
  commissionValue Decimal?        @db.Decimal(10, 2)
  totalEarned     Decimal         @default(0) @db.Decimal(10, 2)
  clicks          Int             @default(0)
  totalPaid       Decimal         @default(0) @db.Decimal(10, 2)

  // Co-organizers (MANAGER) only.
  permissions     EventPermission[] @default([])
  // Most free tickets they can have sent (not cancelled); null = no limit.
  freeTicketLimit Int?

  event    Event             @relation(fields: [eventId], references: [id])
  user     User              @relation(fields: [userId], references: [id])
  orders   Order[]           @relation("OrderPromoter")
  // Payments to a promoter, as the organizer records them (they happen
  // outside NeoPass). totalPaid is their sum.
  payments PromoterPayment[]

  @@unique([eventId, userId, role])
  @@index([eventId])
  @@index([userId])
}

model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  title   String
  message String
  isRead  Boolean          @default(false)

  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  actionUrl String?
  metadata  Json?

  // Notices that add up (sales of an event, of a promoter) share this key
  // while unread: the next one adds to it. Reading it clears the key, so the
  // next one opens a new notice.
  openGroupKey String?

  createdAt  DateTime @default(now())
  // Last news on the notice (it moves up when it adds up); lists sort by it.
  activityAt DateTime @default(now())

  @@unique([userId, openGroupKey])
  @@index([userId, activityAt])
  @@index([userId])
  @@index([eventId])
}

model PromoterPayment {
  id        String   @id @default(uuid())
  amount    Decimal  @db.Decimal(10, 2)
  note      String?
  createdAt DateTime @default(now())

  eventStaffId   String
  eventStaff     EventStaff @relation(fields: [eventStaffId], references: [id])
  registeredById String
  registeredBy   User       @relation(fields: [registeredById], references: [id])

  @@index([eventStaffId])
}

// Free tickets ("QR free") the organizer sent to one email in one go. They do
// not count against the stock and are never linked to an account.
model FreeTicketGrant {
  id             String    @id @default(uuid())
  recipientEmail String
  recipientName  String?
  // Last moment the tickets let people in; null = the whole event.
  validUntil     DateTime?
  createdAt      DateTime  @default(now())
  // When the email was last queued, to space out resends.
  lastSentAt     DateTime  @default(now())
  cancelledAt    DateTime?

  eventId      String
  event        Event      @relation(fields: [eventId], references: [id])
  ticketTypeId String
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])
  issuedById   String
  issuedBy     User       @relation(fields: [issuedById], references: [id])
  tickets      Ticket[]

  @@index([eventId])
  @@index([ticketTypeId])
  @@index([issuedById, createdAt])
}

// What was done on an event and by whom, for its owner: with co-organizers
// several people can change prices, send free tickets or pay promoters.
model EventActivity {
  id        String            @id @default(uuid())
  type      EventActivityType
  // In Spanish, as the owner reads it; fixed when it happened.
  summary   String
  createdAt DateTime          @default(now())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])
  actorId String
  actor   User   @relation(fields: [actorId], references: [id])

  @@index([eventId, createdAt])
}
